{
  "name": "evara-lux",
  "version": "0.1.0",
  "private": true,
  "description": "EVARA-LUX monorepo — backend/orchestrator + design/aura system",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "design:verify": "npm run verify --workspace=@evara-lux/design",
    "backend:dev": "npm run dev --workspace=@evara-lux/backend"
  },
  "engines": {
    "node": ">=20"
  }
}
